# ---------------------------------------------------------------------------
# PayPilot AI — environment configuration
# Copy this file to `.env` in the project root and fill in your own values.
# NEVER commit the real `.env` file.
# ---------------------------------------------------------------------------

# ------------------------------- application
APP_NAME="PayPilot AI"
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=false

# Comma separated list of allowed frontend origins (Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite by default. Absolute paths also work: sqlite:///C:/data/paypilot.db
DATABASE_URL=sqlite:///./paypilot.db

# Demo rows are clearly labelled DEMO in the UI and are disabled automatically
# when APP_ENV=production. Delete paypilot.db to start from a clean slate.
SEED_DEMO_DATA=true

# ------------------------------------------ PayPal Sandbox (required for live flow)
# Get these from https://developer.paypal.com  ->  Apps & Credentials  ->  Sandbox
# Leave empty to run in clearly-labelled DEMO mode (simulated checkout only).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CURRENCY=USD
PAYPAL_BRAND_NAME="PayPilot AI"
PAYPAL_RETURN_URL=http://localhost:5173/payment/result?outcome=success
PAYPAL_CANCEL_URL=http://localhost:5173/payment/result?outcome=cancelled
PAYPAL_MODE=sandbox
PAYPAL_TIMEOUT_SECONDS=25

# Safety interlock: real-money payments stay disabled unless you opt in.
# This project is built for Sandbox. Do not change this for the hackathon.
ALLOW_LIVE_PAYMENTS=false

# ------------------------------------------------------------- AI provider
# demo             -> deterministic rule engine, clearly labelled in the UI
# openai           -> OpenAI Chat Completions (JSON mode)
# anthropic        -> Anthropic Messages API
# openai_compatible-> any OpenAI-shaped endpoint (Ollama, LM Studio, Groq...)
AI_PROVIDER=demo

# Used when AI_PROVIDER=openai (or generic). Also reads OPENAI_API_KEY.
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# Vendor-specific alternatives (used if AI_API_KEY is empty).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

AI_TIMEOUT_SECONDS=30
AI_MAX_TOKENS=700
